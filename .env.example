# ============================================================
# PROMPTWARS / SCHOLAR CODEX — Environment Configuration
# Copy this file to ".env" and fill in your values.
# ============================================================

# ---- Gemini API Keys ----------------------------------------
# Primary key — set YOUR personal Gemini API key here.
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE

# Optional backup/demo keys (rotate on quota exhaustion)
# GEMINI_DEMO_KEY_1=AIzaSy_BACKUP_1
# GEMINI_DEMO_KEY_2=AIzaSy_BACKUP_2

# ---- Server -------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- Security -----------------------------------------------
# A long random secret for session signing
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# ---- Firebase (optional — only if using Cloud Firestore) ---
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-firebase-api-key
