rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and private workspace notes
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Website projects collection
    match /websiteProjects/{projectId} {
      allow read: if true; // Public preview permitted
      allow write: if request.auth != null || resource == null; // Authors can create and update
    }
    
    // Notes and workbooks
    match /workbooks/{workbookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
